local function checkRemote(instance)
    if stopped or instance.Parent ~= watchedSystem then return false end
    if isRandomCleanupName(instance.Name) and safeDestroy(instance) then return false end
    if not (instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction")
        or instance:IsA("UnreliableRemoteEvent")) then return true end
    if allowedRemotes[instance.Name] then return true end
    remoteGuardTriggered = true
    stopped = true
    -- Direct method call avoids this script's __namecall kick blocker.
    player.Kick(player, "Anti cheat updated. Please open a ticket and report this.")
    return false
end
local function watchRemote(instance)
    if not checkRemote(instance) then return end
    if not (instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction")
        or instance:IsA("UnreliableRemoteEvent")) or remoteNameConnections[instance] then return end
    remoteNameConnections[instance] = instance:GetPropertyChangedSignal("Name"):Connect(function()
        checkRemote(instance)
    end)
    instance.Destroying:Once(function()
        local connection = remoteNameConnections[instance]
        if connection then connection:Disconnect(); remoteNameConnections[instance] = nil end
    end)
end

local function cleanStorageChild(instance)
    if stopped or instance.Parent ~= CleanupStorage then return end
    if isRandomCleanupName(instance.Name) then
        safeDestroy(instance)
    end
end

-- Connect before scanning so additions during initialization are also caught.
