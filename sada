        assert(type(transport)=="function","HTTP requests are unavailable.")
        local attempts=method=="GET" and 3 or 1
        local lastError="Couldn't reach cloud configs. Please try Refresh."
        for attempt=1,attempts do
            if not alive then error("Window closed",0) end
            local headers={["Content-Type"]="application/json"}
            if owner then headers.Authorization="Bearer "..owner end
            local options={Url=endpoint..pathName,Method=method,Headers=headers}
            if body then options.Body=HttpService:JSONEncode(body) end
            local received,response=pcall(transport,options)
            if not alive then error("Window closed",0) end
            if received and type(response)=="table" then
                local ok,data=pcall(HttpService.JSONDecode,HttpService,response.Body or "")
                local code=tonumber(response.StatusCode or response.Status) or 0
                if ok and type(data)=="table" and code>=200 and code<500 then
                    if code>=300 then error(data.error or "Cloud request failed.",0) end
                    return data
                end
                lastError=code>=500 and "Cloud configs are temporarily unavailable. Try again shortly." or "Cloud configs returned an invalid response. Please retry."
            end
            if attempt<attempts then
                state.Text="Reconnecting to cloud configs... ("..tostring(attempt).."/2)"
                task.wait(attempt*0.6)
            end
        end
        if method~="GET" then error("Couldn't confirm the change. Refresh My uploads before trying again.",0) end
        error(lastError,0)
