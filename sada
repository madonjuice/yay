        if armOn and #arms>0 then
            for _,a in ipairs(arms) do local d=pos-a.Position
                if math.abs(d.X)<=armX and math.abs(d.Y)<=armY and math.abs(d.Z)<=armZ then
                    local key=tostring(ball)..tostring(a)
                    if not touchDebounce[key] or (now-touchDebounce[key])>=DEBOUNCE_TIME then touchDebounce[key]=now firetouchinterest(ball,a,0) firetouchinterest(ball,a,1) end
                end
            end
        end
        if headOn and headPart and not isSupportedExecutor then
            local torso=character and character:FindFirstChild("Torso")
            if torso then
                local sp=torso.Position+Vector3.new(0,1,0) local d=pos-sp
                if d.Y>=0 and d.Y<=headY and math.abs(d.X)<=headX and math.abs(d.Z)<=headZ then
                    local key=tostring(ball).."head"
                    if not touchDebounce[key] or (now-touchDebounce[key])>=DEBOUNCE_TIME then touchDebounce[key]=now firetouchinterest(ball,headPart,0) firetouchinterest(ball,headPart,1) end
                end
            end
        end
        if ballOn and (ball.Name=="TPS" or ball.Name=="PSoccerBall") and #legs>0 then
            for _,l in legs do
                if (pos-l.Position).Magnitude<=ballSize then
                    local key=tostring(ball)..tostring(l).."ballreach"
                    if not touchDebounce[key] or (now-touchDebounce[key])>=DEBOUNCE_TIME then touchDebounce[key]=now firetouchinterest(ball,l,0) firetouchinterest(ball,l,1) end
                end
            end
        end
    end

    if antiBallFlingEnabled then
        if character then
            for _,v in ipairs(character:GetChildren()) do
                if v:IsA("BasePart") then
                    v.RotVelocity=Vector3.new(0,0,0)
                    if v.Velocity.Magnitude>120 then local pv=v.Velocity v.Velocity=Vector3.new(math.clamp(pv.X,-120,120),math.clamp(pv.Y,-120,120),math.clamp(pv.Z,-120,120)) end
                end
            end
        end
        local tpsSys=workspace:FindFirstChild("TPSSystem")
        if tpsSys then local ball=tpsSys:FindFirstChild("TPS") if ball and ball:IsA("BasePart") then
            local vel=ball.Velocity if vel.Magnitude>140 then ball.Velocity=Vector3.new(math.clamp(vel.X,-100,100),math.clamp(vel.Y,-50,50),math.clamp(vel.Z,-100,100)) end
        end end
    end
end)

