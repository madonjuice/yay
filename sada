-- Shared refresh controller for React and manual FFlag overrides.
local reactFlags = (function()
    local desired, warned, names = {}, {}, {}
    local alive = true
    local env = getgenv and getgenv() or _G
    if type(env.AeroTPSStopFlags) == "function" then env.AeroTPSStopFlags() end
    local function stop() alive = false; table.clear(desired) end
    env.AeroTPSStopFlags = stop
    local destroy = Window.Destroy
    function Window:Destroy(...)
        stop()
        return destroy(self, ...)
    end
    local function write(flag, value)
        if type(setfflag) == "function" then
            local short = flag:gsub("^DFInt", ""):gsub("^FInt", "")
            for _, name in ipairs(names[flag] and {names[flag]} or {short, flag}) do
                local ok, result = pcall(setfflag, name, value)
                if ok and result ~= false then names[flag] = name; return true end
            end
            names[flag] = nil
        end
        if not warned[flag] then
            warned[flag] = true
            warn("[AERO] Unable to set " .. flag .. "; executor may not support this flag.")
        end
        return false
    end
    task.spawn(function()
        while alive do
            task.wait(0.5)
            if alive then
                for flag, entry in pairs(desired) do write(flag, entry.value) end
            end
        end
    end)
    return {
        Set = function(flag, value, owner)
            desired[flag] = {value = tostring(value), owner = owner}
            write(flag, tostring(value))
        end,
        Clear = function(owner)
            for flag, entry in pairs(desired) do
                if not owner or entry.owner == owner then desired[flag] = nil end
            end
        end,
        Write = write,
    }
end)()

