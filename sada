                task.delay(0.24, function()
                    if overlay.Parent and stepIndex == requestedStep then
                        if step.Scroll and step.Target and step.Target ~= step.Scroll then
                            local contentY = step.Target.AbsolutePosition.Y - step.Scroll.AbsolutePosition.Y + step.Scroll.CanvasPosition.Y
                            step.Scroll.CanvasPosition = Vector2.new(0, math.max(0, contentY - 12))
                        end
                        refreshSpotlight(findStepTarget(step), step.Scroll)
                    end
