                label.Position = position
                label.Size = size
                label.BackgroundTransparency = 1
                label.TextColor3 = color
                label.TextSize = textSize
                label.Font = font or (bold and Enum.Font.GothamSemibold or Enum.Font.Gotham)
                label.TextWrapped = true
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.TextYAlignment = Enum.TextYAlignment.Center
                label.ZIndex = 1812
                label.Parent = card
                return label
            end
            local accent = Color3.fromRGB(105,176,255)
            addLabel("Eyebrow", "AERO  /  QUICK TOUR", UDim2.new(0,24,0,18), UDim2.new(1,-48,0,16), 10, accent, Enum.Font.Code, true)
            local title = addLabel("Title", "Welcome", UDim2.new(0,24,0,48), UDim2.new(1,-48,0,30), 21, Color3.fromRGB(245,247,250), nil, true)
            title.TextWrapped = false
            title.TextTruncate = Enum.TextTruncate.AtEnd
            local body = addLabel("Body", "A quick look at the main tabs. Start the tour or skip it and open the tabs yourself.",
                UDim2.new(0,24,0,88), UDim2.new(1,-48,0,66), 13, Color3.fromRGB(176,182,192))
            local pageLabel = addLabel("Page", "VERSION  "..SCRIPT_VERSION, UDim2.new(0,24,0,171), UDim2.new(1,-48,0,16), 10,
                Color3.fromRGB(137,145,158), Enum.Font.Code)

            local function makeButton(name, text, position, size, primary)
                local button = Instance.new("TextButton")
                button.Name = name
                button.Text = text
                button.Position = position
                button.Size = size
                button.BackgroundColor3 = primary and accent or Color3.fromRGB(29,33,40)
                button.BorderSizePixel = 0
                button.TextColor3 = primary and Color3.fromRGB(12,16,22) or Color3.fromRGB(230,233,238)
                button.Font = Enum.Font.GothamSemibold
                button.TextSize = 13
                button.AutoButtonColor = true
                button.ZIndex = 1813
                button.Parent = card
                Instance.new("UICorner", button).CornerRadius = UDim.new(0,8)
                return button
            end
            local backButton = makeButton("Back", "Back", UDim2.new(0,24,1,-58), UDim2.new(0,86,0,38), false)
            local nextButton = makeButton("StartOrNext", "Start tutorial", UDim2.new(0,118,1,-58), UDim2.new(1,-142,0,38), true)
            local skipButton = makeButton("Skip", "Skip", UDim2.new(1,-86,0,15), UDim2.new(0,62,0,28), false)

            local panelDescriptions = {
                ["Script feedback"] = "Choose a rating from 1 to 5 and send feedback.",
                ["Live session"] = "View the game, server size, ping, FPS, session time, and version.",
                ["Leg Reach Controls"] = "Toggle leg reach and adjust its X, Y, and Z range.",
                ["Leg Visuals & Timing"] = "Show the reach visualizer and set the touch delay.",
                ["Left Leg Reach"] = "Toggle and set the size of left leg reach.",
