            local headers = {["Content-Type"] = "application/json"}
            if auth then headers.Authorization = "Bearer " .. auth end
            local options = {Url = endpoint .. path, Method = method, Headers = headers}
            if body then options.Body = Http:JSONEncode(body) end
            local ok, response = pcall(transport, options)
            if ok and type(response) == "table" then
                local code = tonumber(response.StatusCode or response.Status) or 0
                local decoded, data = pcall(Http.JSONDecode,Http,response.Body or "")
                if decoded and type(data) == "table" and code >= 200 and code < 500 then
