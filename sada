end) end})
local function loadConfig(name, validateOnly, onlyChanged)
    assert(type(readfile) == "function", "This executor does not provide readfile.")
    local data = HttpService:JSONDecode(readfile(path(name)))
    if type(data) == "table" and data.Version == nil and (data.state or data.toggles or data.sliders) then
        local old, values = {}, {}
        for _, group in ipairs({"state", "toggles", "sliders"}) do
            if type(data[group]) == "table" then
                for key, value in pairs(data[group]) do old[key] = value end
            end
        end
        for key, entry in pairs(ConfigStore.Entries) do values[key] = old[entry.Config.Title] end
        data = {Version = 1, Script = "AERO-TPS", Values = values}
    end
    assert(type(data) == "table" and data.Version == 1 and data.Script == "AERO-TPS" and type(data.Values) == "table",
        "Unsupported or empty old config. Save a new config with this version.")
    local count = 0
    for key, value in pairs(data.Values) do
        local entry = ConfigStore.Entries[key]
        if entry then assert(validate(entry, value), "Invalid value for " .. key) count += 1 end
    end
    assert(count > 0, "No recognized settings in this config.")
    if validateOnly then return end
    configName = name
    table.clear(ConfigStore.Errors)

    for _, kind in ipairs({"Slider", "Input", "Keybind", "Dropdown", "Toggle"}) do
        for _, key in ipairs(ConfigStore.Order) do
            local entry, value = ConfigStore.Entries[key], data.Values[key]
            if entry.Kind == kind and value ~= nil and (not onlyChanged or entry.Value ~= value) then
                apply(entry, value)
                if kind == "Toggle" and entry.Value ~= value then
                    ConfigStore.Errors[key] = "Feature could not accept its saved state"
                end
            end
        end
    end
    assert(next(ConfigStore.Errors) == nil, "Some feature callbacks failed; see the console.")
    report("Loaded " .. configName .. " (" .. count .. " settings)")
end
