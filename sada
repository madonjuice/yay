        contentLayout.Parent = content
        local function fitContent()
            content.Size = UDim2.new(1,0,0,contentLayout.AbsoluteContentSize.Y)
        end
        contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitContent)
        fitContent()
        fitCard()
    end

    return setmetatable({}, {
        __index = function(_, method)
            return function(_, ...)
                local fn = tab[method]
                if type(fn) ~= "function" then return nil end
                local result = fn(tab, ...)
                local entry = Window.SearchIndex[#Window.SearchIndex]
                if entry and entry.TabTitle == tab.Title and entry.Frame then
                    ensureCard(entry)
                    if card and content and entry.Frame:IsA("GuiObject") then
                        entry.Frame.Parent = content
                        entry.Frame.Size = UDim2.new(1,0,0,entry.Frame.Size.Y.Offset)
                        local rowEstimate = entry.Frame.Size.Y.Offset
                        if entry.Type == "Input" then rowEstimate = math.max(rowEstimate, 96) end
                        if entry.Type == "Paragraph" then rowEstimate = math.max(rowEstimate, 64) end
                        if cardEstimateKey then state[cardEstimateKey] += rowEstimate + 7 end
                        if entry.Type == "Input" and card.AbsoluteSize.X < 320 then
                            local inputBox = entry.Frame:FindFirstChildWhichIsA("TextBox", true)
                            local inputFrame = inputBox and inputBox.Parent
                            local textColumn = entry.Frame:FindFirstChild("TextColumn", true)
                            if inputFrame and textColumn then
                                textColumn.Size = UDim2.new(1,-16,0,0)
                                inputFrame.AnchorPoint = Vector2.new(0,0)
                                inputFrame.Size = UDim2.new(1,-16,0,25)
                                inputFrame.BackgroundColor3 = Color3.fromRGB(38,38,38)
                                inputFrame.BackgroundTransparency = 0.1
                                local function placeInput()
                                    local top = textColumn.Position.Y.Offset + textColumn.AbsoluteSize.Y + 8
                                    inputFrame.Position = UDim2.new(0,8,0,top)
                                    entry.Frame.Size = UDim2.new(1,0,0,top + inputFrame.Size.Y.Offset + 8)
                                    if content then
                                        local contentLayout = content:FindFirstChildOfClass("UIListLayout")
                                        if contentLayout then
                                            content.Size = UDim2.new(1,0,0,contentLayout.AbsoluteContentSize.Y)
                                        end
                                    end
                                    if card then
                                        local cardLayout = card:FindFirstChildOfClass("UIListLayout")
                                        if cardLayout then card.Size = UDim2.new(1,0,0,cardLayout.AbsoluteContentSize.Y + 20) end
                                    end
                                end
                                textColumn:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeInput)
                                task.defer(placeInput)
                            end
                        end
                        if card then
                            local cardLayout = card:FindFirstChildOfClass("UIListLayout")
                            if cardLayout then
                                task.defer(function()
                                    if card and card.Parent then
                                        card.Size = UDim2.new(1,0,0,cardLayout.AbsoluteContentSize.Y + 20)
                                    end
                                end)
                            end
                        end
                    end
                end
                return result
            end
        end
    })
end

