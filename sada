            iconImage.Size = UDim2.fromOffset(18,18)
            iconImage.ScaleType = Enum.ScaleType.Fit
            iconImage.ZIndex = 19
            iconImage.Parent = header
            if type(iconValue) == "table" then
                iconImage.Image = iconValue.Image or ""
                if iconValue.ImageRectOffset then iconImage.ImageRectOffset = iconValue.ImageRectOffset end
                if iconValue.ImageRectSize then iconImage.ImageRectSize = iconValue.ImageRectSize end
            elseif typeof(iconValue) == "string" then
