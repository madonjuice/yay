local function Morph(UserId,targetCharacter)
    if not targetCharacter then return end
    local humanoid=targetCharacter:FindFirstChildOfClass("Humanoid") if not humanoid then return end
    local success,appearance=pcall(function() return Players:GetCharacterAppearanceAsync(UserId) end)
    if not success or not appearance then return end
    local targetHasHeadless,targetHasKorblox=false,false
    local descSuccess,desc=pcall(function() return Players:GetHumanoidDescriptionFromUserId(UserId) end)
    if descSuccess and desc then
        if desc.Head==47079 or desc.Head==1340101835 or desc.Head==6340101835 or desc.Head==6686307858 then targetHasHeadless=true end
        if desc.RightLeg==139607718 then targetHasKorblox=true end
    end
    for _,v in pairs(targetCharacter:GetChildren()) do
        if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("CharacterMesh") or v:IsA("BodyColors") then v:Destroy() end
    end
    if targetCharacter:FindFirstChild("Head") then
        for _,child in ipairs(targetCharacter.Head:GetChildren()) do if child:IsA("Decal") then child:Destroy() end end
    end
    for _,v in ipairs(appearance:GetDescendants()) do
        if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then pcall(function() local c=v:Clone() c.Parent=targetCharacter end)
        elseif v:IsA("Accessory") then pcall(function() local c=v:Clone() humanoid:AddAccessory(c) end)
        elseif v:IsA("CharacterMesh") then pcall(function() local c=v:Clone() c.Parent=targetCharacter end) end
    end
    local faceTexture=nil
    for _,d in ipairs(appearance:GetDescendants()) do
        if d:IsA("Decal") and (d.Name=="face" or d.Name=="Face") then faceTexture=d.Texture break end
    end
    if not faceTexture and descSuccess and desc and desc.Face>0 then
        pcall(function()
            local objects=game:GetObjects("rbxassetid://"..tostring(desc.Face))
            if objects and #objects>0 then
                for _,obj in ipairs(objects) do
                    if obj:IsA("Decal") then faceTexture=obj.Texture break end
                    for _,child in ipairs(obj:GetDescendants()) do if child:IsA("Decal") then faceTexture=child.Texture break end end
                    if faceTexture then break end
                end
            end
        end)
    end
    local head=targetCharacter:FindFirstChild("Head")
    if head then
        local face=Instance.new("Decal") face.Face=Enum.NormalId.Front face.Name="face"
        face.Texture=faceTexture or "rbxasset://textures/face.png" face.Transparency=0 face.Parent=head
    end
    if targetHasHeadless and targetCharacter:FindFirstChild("Head") then
        targetCharacter.Head.Transparency=1
        if targetCharacter.Head:FindFirstChildOfClass("SpecialMesh") then targetCharacter.Head:FindFirstChildOfClass("SpecialMesh").MeshId=""
        else local fc=targetCharacter.Head:FindFirstChildOfClass("FaceControls") if fc then fc:Destroy() end end
    elseif targetCharacter:FindFirstChild("Head") then targetCharacter.Head.Transparency=0 end
    if targetHasKorblox then
        if targetCharacter:FindFirstChild("RightLowerLeg") then targetCharacter.RightLowerLeg.MeshId="902942093" targetCharacter.RightLowerLeg.Transparency=1 end
        if targetCharacter:FindFirstChild("RightUpperLeg") then targetCharacter.RightUpperLeg.MeshId="http://www.roblox.com/asset/?id=902942096" targetCharacter.RightUpperLeg.TextureID="http://roblox.com/asset/?id=902843398" end
        if targetCharacter:FindFirstChild("RightFoot") then targetCharacter.RightFoot.MeshId="902942089" targetCharacter.RightFoot.Transparency=1 end
    else
        if targetCharacter:FindFirstChild("RightLowerLeg") then targetCharacter.RightLowerLeg.Transparency=0 end
        if targetCharacter:FindFirstChild("RightFoot") then targetCharacter.RightFoot.Transparency=0 end
    end
    local parent=targetCharacter.Parent targetCharacter.Parent=nil targetCharacter.Parent=parent
end

 
 
 
