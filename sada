                activeBalls[tpsBall]=true local p=airDribbleParts[tpsBall]
                if not p or not p.Parent then
                    p=Instance.new("Part") p.Name="AirDribbleHelper" p.Anchored=true p.CanCollide=true
                    p.Transparency=airDribbleShowPart and 0.55 or 1 p.Material=Enum.Material.Neon
                    p.Color=Color3.fromRGB(0,170,255) p.Size=Vector3.new(airDribbleSize,0.5,airDribbleSize) p.Parent=workspace
                    airDribbleParts[tpsBall]=p
                end
                p.Size=Vector3.new(airDribbleSize,0.5,airDribbleSize) p.Transparency=airDribbleShowPart and 0.55 or 1
                p.CFrame=CFrame.new(tpsBall.Position.X,tpsBall.Position.Y-tpsBall.Size.Y/2-0.25,tpsBall.Position.Z)
            end
        end
        for b,p in pairs(airDribbleParts) do if not activeBalls[b] then if p and p.Parent then p:Destroy() end airDribbleParts[b]=nil end end
    end

    local hrp=character and character:FindFirstChild("HumanoidRootPart")
    if legShow and legVis and #legs>0 and hrp then
        legVis.CFrame=legVis:Center(hrp, legs) legVis.Size=Vector3.new(legX*2,legY*2,legZ*2) legVis.Shape=Enum.PartType.Block
    end
    if armShow and armVis and #arms>0 and hrp then
        armVis.CFrame=armVis:Center(hrp, arms) armVis.Size=Vector3.new(armX*2,armY*2,armZ*2) armVis.Shape=Enum.PartType.Block
    end
    if headShow and headVis then
        local torso=character and character:FindFirstChild("Torso")
        if torso then local sp=torso.Position+Vector3.new(0,1,0) headVis.CFrame=CFrame.new(sp+Vector3.new(0,headY/2,0))*torso.CFrame.Rotation headVis.Size=Vector3.new(headX*2,headY,headZ*2) headVis.Shape=Enum.PartType.Block end
    end
    if headVisSolara and headPart then headVisSolara.CFrame=headPart.CFrame headVisSolara.Size=headPart.Size headVisSolara.Shape=Enum.PartType.Block end
    if leftLegVisSolara and character then local p=character:FindFirstChild("Left Leg") if p then leftLegVisSolara.CFrame=p.CFrame leftLegVisSolara.Size=p.Size end end
    if rightLegVisSolara and character then local p=character:FindFirstChild("Right Leg") if p then rightLegVisSolara.CFrame=p.CFrame rightLegVisSolara.Size=p.Size end end
    if leftArmVisSolara and character then local p=character:FindFirstChild("Left Arm") if p then leftArmVisSolara.CFrame=p.CFrame leftArmVisSolara.Size=p.Size end end
    if rightArmVisSolara and character then local p=character:FindFirstChild("Right Arm") if p then rightArmVisSolara.CFrame=p.CFrame rightArmVisSolara.Size=p.Size end end
    if ballShow then
        for b,vis in pairs(ballVisors) do
            if b and b.Parent then vis.CFrame=b.CFrame vis.Size=Vector3.new(ballSize*2,ballSize*2,ballSize*2)
            else vis:Destroy() ballVisors[b]=nil end
        end
    end

    local now=os.clock()
    for _,ball in ballList do
        if not ball or not ball.Parent then continue end local pos=ball.Position
        if not isSupportedExecutor and legOn and #legs>0 then
            for _,l in legs do
                if not legOn or character ~= player.Character or l.Parent ~= character then continue end
                local d=pos-l.Position
                if math.abs(d.X)<=legX and math.abs(d.Y)<=legY and math.abs(d.Z)<=legZ then
                    local lastTouches = legTouchDebounce[ball]
                    if not lastTouches then
                        lastTouches = setmetatable({}, {__mode = "k"})
                        legTouchDebounce[ball] = lastTouches
                    end
                    local touch = lastTouches[l]
                    if not touch then
                        touch = {last = -math.huge, busy = false, warned = false}
                        lastTouches[l] = touch
                    end
                    -- Bound executor work even with uncapped rendering / zero delay.
                    local interval = math.max(legTouchDelay, 1 / 60)
