                ["Head Reach (Xeno Moss)"] = "Set the Xeno Moss head reach options and presets.",
                ["Ball Prediction"] = "Toggle prediction and adjust its delay and duration.",
                ["Ball Controls"] = "Change ball size and collision settings, or use ball shortcuts.",
                ["Ball Visuals"] = "Change the ball visualizer, trail, and color options.",
                ["Ball Speed & Force"] = "Adjust ball speed and force settings.",
                ["Ball Reach"] = "Toggle ball reach and adjust its size.",
                ["Player"] = "Set player options such as avatar settings.",
                ["Player Stats"] = "Show session goals, passes, play time, and player level.",
                ["Level Changer"] = "Set the displayed player level and respawn options.",
                ["Movement"] = "Adjust movement settings and related controls.",
                ["React"] = "Set the main reaction options and presets.",
                ["Dribble React"] = "Choose a dribble reaction preset.",
                ["Clumsy"] = "Set the Clumsy network delay options.",
                ["Ping Spoof"] = "Set or choose a displayed ping value.",
                ["Helpers"] = "Configure helper toggles and their keybinds.",
                ["FFlag Notes"] = "Read notes about flag settings and support.",
                ["Target Time Delay"] = "Adjust the target time delay value.",
                ["Interpolation"] = "Adjust the interpolation delay value.",
                ["Physics Sender Rate"] = "Adjust the physics sender rate value.",
                ["Map Options"] = "Change map and environment options.",
                ["Misc Options"] = "Change the other visual and game options.",
                ["Skyboxes"] = "Choose a skybox preset.",
                ["Gamepasses"] = "View and use the available gamepass options.",
                ["Kill Players"] = "Configure the player targeting options in this panel.",
                ["Ball Crasher"] = "Configure the ball crasher toggle and its settings.",
                ["Autofarm"] = "Set the autofarm options and toggle it here.",
            }
            local tabDescriptions = {
                ["Settings"] = "Manage saved configs, cloud configs, and settings in this tab.",
            }
            local steps = {}
            for tabIndex, tabName in ipairs(Window.TabOrder) do
                local panels, seenPanels, firstEntry = {}, {}, nil
                for _, entry in ipairs(Window.SearchIndex) do
                    if entry.TabTitle == tabName and entry.Frame then
                        firstEntry = firstEntry or entry
                        local node = entry.Frame
                        while node do
                            local header = node:FindFirstChild("FeatureCardTitle", true)
                            if header and header:IsA("TextLabel") then
                                if not seenPanels[node] then
                                    seenPanels[node] = true
                                    table.insert(panels, {Target=node, Scroll=entry.RightScroll, Title=header.Text})
                                end
                                break
                            end
                            node = node.Parent
                        end
                    end
                end
                if #panels == 0 then
                    table.insert(steps, {
                        Title=tabName, Tab=tabIndex, TabName=tabName,
                        Target=firstEntry and firstEntry.RightScroll or Window.Tabs[tabIndex],
                        Scroll=firstEntry and firstEntry.RightScroll,
                        Body=tabDescriptions[tabName] or ("Open this tab to view its "..tabName.." options."),
                    })
                else
                    for _, panel in ipairs(panels) do
                        table.insert(steps, {
                            Title=tabName.." / "..panel.Title,
                            Tab=tabIndex, TabName=tabName, PanelTitle=panel.Title, Target=panel.Target, Scroll=panel.Scroll,
                            Body=panelDescriptions[panel.Title] or ("This panel contains the "..panel.Title.." options."),
                        })
                    end
                end
