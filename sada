end
local function currentName()
    local value = nameInput and nameInput.GetValue and nameInput:GetValue() or configName
    configName = value:match("^%s*(.-)%s*$")
    return configName
end
local function run(action)
    local ok, err = pcall(action)
    if not ok then report(tostring(err)) end
end
local function refresh()
    local names = {}
    if type(listfiles) == "function" then
        if isfolder and not isfolder("AERO/configs") then
            if selector then selector:Refresh({}) selector:SetValue(configName) end
            return names
        end
        for _, file in ipairs(listfiles("AERO/configs")) do
            local base = file:match("([^/\\]+)$") or file
            local name = base:match("^(.+)%.json$")
            if name and validName(name) then table.insert(names, name) end
        end
    end
    table.sort(names)
    if selector then selector:Refresh(names) selector:SetValue(configName) end
    return names
end
local function validate(entry, value)
    local kind, cfg = entry.Kind, entry.Config
    if kind == "Toggle" then return type(value) == "boolean" end
    if kind == "Slider" then
        return type(value) == "number" and value == value and value >= cfg.Value.Min and value <= cfg.Value.Max
    end
    if type(value) ~= "string" then return false end
    if kind == "Dropdown" then return table.find(cfg.Option, value) ~= nil end
    if kind == "Keybind" then
        if value == "Undefined" or value == "..." or value == "" then return true end
        for _, key in ipairs(Enum.KeyCode:GetEnumItems()) do
            if key.Name == value and key ~= Enum.KeyCode.Unknown then return true end
        end
        return false
    end
    return #value <= 4096
end
local function apply(entry, value)
    assert(entry.Element and entry.Element.SetValue, "A control cannot be restored")
    entry.Element:SetValue(value)

    if entry.Kind == "Dropdown" then entry.Callback(value) end
    task.wait()
