local function makeVis(color, shape, style)
    style = style or {}
    local part = Instance.new("Part")
    part.Name = "AERO_ReachVisual"
    part.Anchored = true
    part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
    part.CastShadow = false
    part.Transparency = style.FillTransparency or 0.95
    part.Material = style.Material or Enum.Material.SmoothPlastic
    part.Color = style.Color or color:Lerp(Color3.fromRGB(210,220,235), 0.45)
    part.Shape = shape or Enum.PartType.Ball
    part.Size = Vector3.new(1,1,1)
    -- Thin outline for box reach; ball reach keeps its spherical surface.
    if part.Shape == Enum.PartType.Block then
        local outline = Instance.new("SelectionBox")
        outline.Name = "AERO_ReachOutline"
        outline.Adornee = part
        outline.LineThickness = 0.02
        outline.SurfaceTransparency = 1
        outline.Color3 = part.Color
        outline.Transparency = style.OutlineTransparency or 0.55
        outline.Parent = part
    else
        part.Transparency = style.FillTransparency or 0.88
        if style.OutlineColor then
            local outline = Instance.new("Highlight")
            outline.Name = "AERO_ReachHighlight"
            outline.Adornee = part
            outline.FillTransparency = 1
            outline.OutlineColor = style.OutlineColor
            outline.OutlineTransparency = style.OutlineTransparency or 0.08
            outline.DepthMode = Enum.HighlightDepthMode.Occluded
            outline.Parent = part
        end
    end
    part.Parent = Workspace2
    local visual = {}
    local cached = {Size = part.Size, Shape = part.Shape}
    function visual:Destroy() part:Destroy() end
    local trackedRoot, offset
    function visual:Center(root, limbs)
        local sum, count = Vector3.zero, 0
        if limbs and root and root.Parent then
            for _, limb in ipairs(limbs) do
                if limb and limb:IsA("BasePart") and limb.Parent == root.Parent then
                    sum += limb.Position
                    count += 1
                end
            end
        end
        if count > 0 then
            offset = root.CFrame:PointToObjectSpace(sum / count)
            trackedRoot = root
        elseif trackedRoot ~= root then
            trackedRoot = root
            offset = Vector3.zero
        end
        return root.CFrame * CFrame.new(offset or Vector3.zero)
    end
    return setmetatable(visual, {
        __index = function(_, key) return part[key] end,
        __newindex = function(_, key, value)
            if cached[key] == value then return end
            cached[key] = value
            part[key] = value
        end,
    })
end

 
 
 
do
    local updateInterval, horizon = 0.05, 2
    local connection, folder, anchor
    local points, beams = {}, {}
    local STEP, MAX_STEPS, SKIN = 1 / 60, 240, 0.01
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.RespectCanCollide = true
    params.IgnoreWater = true

    local function hideTrail(first)
        for i = first or 1, #beams do beams[i].Enabled = false end
    end

    local function drawTrail(path)
        if not folder or not folder.Parent then
            folder = Instance.new("Folder")
            folder.Name = "AeroBallPrediction"
            folder.Parent = workspace
            anchor = Instance.new("Part")
            anchor.Name = "TrailAnchor"
            anchor.Anchored, anchor.Transparency = true, 1
            anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = false, false, false
            anchor.CastShadow = false
            anchor.CFrame = CFrame.new()
            anchor.Parent = folder
            table.clear(points)
            table.clear(beams)
        end
        for i, position in ipairs(path) do
            if not points[i] then
                points[i] = Instance.new("Attachment")
                points[i].Parent = anchor
            end
            points[i].Position = position
            if i > 1 then
                local beam = beams[i - 1]
                if not beam then
                    beam = Instance.new("Beam")
                    beam.Attachment0, beam.Attachment1 = points[i - 1], points[i]
                    beam.FaceCamera = true
                    beam.Segments = 1
                    beam.LightEmission, beam.LightInfluence = 0.25, 0
                    beam.Color = ColorSequence.new(Color3.fromRGB(175, 215, 235))
                    beam.Parent = anchor
                    beams[i - 1] = beam
                end
                local a, b = (i - 2) / math.max(1, #path - 1), (i - 1) / math.max(1, #path - 1)
                beam.Width0, beam.Width1 = 0.09 - 0.06 * a, 0.09 - 0.06 * b
                beam.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.12 + 0.68 * a),
                    NumberSequenceKeypoint.new(1, 0.12 + 0.68 * b),
                })
                beam.Enabled = true
            end
        end
        hideTrail(#path)
    end

    local function surfaceProperties(hit)
        if hit.Instance:IsA("BasePart") then
            return hit.Instance.CurrentPhysicalProperties, hit.Instance:GetVelocityAtPosition(hit.Position)
        end
        return PhysicalProperties.new(hit.Material), Vector3.zero
    end

    local function blend(a, b, value, weight)
        local total = a[weight] + b[weight]
        return total > 0 and (a[value] * a[weight] + b[value] * b[weight]) / total
            or (a[value] + b[value]) * 0.5
    end

     
     
    local function applyContact(velocity, spin, normal, surfaceVelocity, radius, friction, normalImpulse)
        local arm = -normal * radius
        local slip = velocity - surfaceVelocity + spin:Cross(arm)
        slip = slip - normal * slip:Dot(normal)
        if slip.Magnitude > 0.0001 then
            local impulse = -slip.Unit * math.min(slip.Magnitude * (2 / 7), friction * normalImpulse)
            velocity = velocity + impulse
            spin = spin + arm:Cross(impulse) * (2.5 / (radius * radius))
        end
        return velocity, spin
    end

    local function updatePrediction()
        local system = workspace:FindFirstChild("TPSSystem")
        local ball = system and system:FindFirstChild("TPS")
        if not ball or not ball:IsA("BasePart") or ball.Anchored then hideTrail(); return end
        local position, velocity, spin = ball.Position, ball.AssemblyLinearVelocity, ball.AssemblyAngularVelocity
        if velocity.Magnitude ~= velocity.Magnitude or velocity.Magnitude > 10000 then hideTrail(); return end
        local ignore = {ball}
        if folder then table.insert(ignore, folder) end
        local proxy = workspace:FindFirstChild("ClientBallProxy_TPS")
        if proxy then table.insert(ignore, proxy) end
        params.FilterDescendantsInstances = ignore
        params.CollisionGroup = ball.CollisionGroup
        local radius = math.clamp(math.min(ball.Size.X, ball.Size.Y, ball.Size.Z) / 2, 0.05, 100)
        local gravity = Vector3.new(0, -workspace.Gravity, 0)
        local ballPhysics = ball.CurrentPhysicalProperties
         
         
        for _, direction in ipairs({Vector3.xAxis, -Vector3.xAxis, Vector3.yAxis,
            -Vector3.yAxis, Vector3.zAxis, -Vector3.zAxis}) do
            local hit = workspace:Raycast(position, direction * radius, params)
            if hit then
                local gap = (position - hit.Position):Dot(hit.Normal)
                if gap >= 0 and gap < radius then position = position + hit.Normal * (radius - gap + SKIN) end
            end
        end
        local path, time = {position}, 0
        for step = 1, MAX_STEPS do
            if time >= horizon then break end
            local dt = math.min(STEP, horizon - time, 24 / math.max(velocity.Magnitude, 1))
            local remaining, resolved = dt, true
            for impact = 1, 4 do
                local acceleration = gravity
                local support = workspace:Spherecast(position + Vector3.yAxis * 0.05,
                    radius, -Vector3.yAxis * 0.12, params)
                if support and support.Normal.Y > 0.3 then
                    local material, surfaceVelocity = surfaceProperties(support)
                    local normal = support.Normal
                    local normalSpeed = (velocity - surfaceVelocity):Dot(normal)
                    if normalSpeed >= -1 and normalSpeed <= 0.25 then
                        position = position + normal * math.max(0, radius + SKIN - (position - support.Position):Dot(normal))
                        velocity = velocity - normal * normalSpeed
                        acceleration = gravity - normal * gravity:Dot(normal)
                        velocity, spin = applyContact(velocity, spin, normal, surfaceVelocity, radius,
                            blend(ballPhysics, material, "Friction", "FrictionWeight"),
                            math.max(0, -gravity:Dot(normal)) * remaining)
                    end
                end
                local displacement = velocity * remaining + acceleration * (0.5 * remaining * remaining)
                if displacement.Magnitude < 0.000001 then remaining = 0; break end
                local hit = workspace:Spherecast(position, radius, displacement, params)
                if not hit then
                    position = position + displacement
                    velocity = velocity + acceleration * remaining
                    remaining = 0
                    break
                end
                local elapsed = remaining * math.clamp(hit.Distance / displacement.Magnitude, 0, 1)
                position = position + displacement.Unit * hit.Distance + hit.Normal * SKIN
                velocity = velocity + acceleration * elapsed
                 
                if (position - path[#path]).Magnitude > 0.001 then table.insert(path, position) end
                local material, surfaceVelocity = surfaceProperties(hit)
                local normalSpeed = (velocity - surfaceVelocity):Dot(hit.Normal)
                if normalSpeed < 0 then
                    local restitution = blend(ballPhysics, material, "Elasticity", "ElasticityWeight")
                    if -normalSpeed < 1 then restitution = 0 end
                    local impulse = -(1 + restitution) * normalSpeed
                    velocity = velocity + hit.Normal * impulse
                    velocity, spin = applyContact(velocity, spin, hit.Normal, surfaceVelocity, radius,
                        blend(ballPhysics, material, "Friction", "FrictionWeight"), impulse)
                end
                remaining = remaining - elapsed
                if remaining < 0.00001 then remaining = 0; break end
                if impact == 4 then resolved = false end
            end
            if (position - path[#path]).Magnitude > 0.001 then table.insert(path, position) end
            if not resolved then break end  
            time = time + dt
            if velocity.Magnitude < 0.1 and remaining == 0 then
                local ground = workspace:Raycast(position, -Vector3.yAxis * (radius + 0.1), params)
                if ground then break end
            end
        end
        if #path > 1 then drawTrail(path) else hideTrail() end
    end

    local function stopPrediction()
        if connection then connection:Disconnect(); connection = nil end
        if folder then folder:Destroy(); folder = nil; anchor = nil end
        table.clear(points)
        table.clear(beams)
    end

    local BallPredGroup = SafeGroup(BallTab, {Title="Ball Prediction", Collapsed=false})
    BallPredGroup:Toggle({Title="Ball Prediction",Default=false,Callback=function(value)
        setFeatureState("Ball Prediction", value)
        stopPrediction()
        if not value then return end
        local elapsed = updateInterval
        connection = RunService.Heartbeat:Connect(function(dt)
            elapsed = elapsed + dt
            if elapsed < updateInterval then return end
            elapsed = 0
            updatePrediction()
        end)
    end})
    BallPredGroup:Slider({Title="Prediction Update Delay",Value={Min=0.03,Max=0.5,Default=0.05},Step=0.01,Callback=function(value)
        updateInterval = math.clamp(value, 0.03, 0.5)
    end})
    BallPredGroup:Slider({Title="Prediction Duration",Value={Min=0.5,Max=3,Default=2},Step=0.1,Callback=function(value)
        horizon = math.clamp(value, 0.5, 3)
    end})
end

 
 
 
