                if type(writefile) == "function" then pcall(writefile, tutorialFlag, "seen") end
                if overlay.Parent then overlay:Destroy() end
                if tutorialBlur.Parent then tutorialBlur:Destroy() end
                if host.Frame and host.Frame.Parent then host.Frame:Destroy() end
