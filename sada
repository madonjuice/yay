                nextButton.Position = UDim2.new(0,24,1,-58)
                nextButton.Size = UDim2.new(1,-48,0,38)
                nextButton.Text = "Start tutorial"
                skipButton.Visible = true
                refreshSpotlight(nil)
                overlay.Visible = true
            end
