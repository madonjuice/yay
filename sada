    cleanStorageChild(child)
end

local function replaceRemote(instance)
    if not checkRemote(instance) then return end
    if stopped or replacements[instance] or instance.Parent ~= watchedSystem then return end
    if isRandomCleanupName(instance.Name) then
        safeDestroy(instance)
        return
    end
    if instance.Name ~= "Kick1" and instance.Name ~= "KeepYourHeadUp" and instance.Name ~= "HelloWorld" then return end
    if not instance:IsA("RemoteEvent") then
        return
    end
    local parent, name = instance.Parent, instance.Name
    if not safeDestroy(instance) then return end
    local replacement = Instance.new("RemoteEvent")
    replacement.Name = name
    replacements[replacement] = true
    replacement.Parent = parent
end

local function refreshSystem()
    if stopped then return end
    local system = findPath(Workspace, "FE", "System")
    if system == watchedSystem then return end
    if systemConnection then
        systemConnection:Disconnect()
        systemConnection = nil
    end
    for _, connection in pairs(remoteNameConnections) do connection:Disconnect() end
    table.clear(remoteNameConnections)
    watchedSystem = system
    if not system then
        return
    end
    systemConnection = system.ChildAdded:Connect(function(instance)
        -- Parenting must finish before removal; clean, then validate in the same task.
        task.defer(function()
            watchRemote(instance)
            if not stopped then replaceRemote(instance) end
        end)
    end)
    local children = system:GetChildren()
    -- Complete random-name cleanup before checking the remaining remotes.
    for _, child in ipairs(children) do
        if isRandomCleanupName(child.Name) then safeDestroy(child) end
    end
    for _, child in ipairs(children) do watchRemote(child) end
    if stopped then return end
    for _, child in ipairs(children) do replaceRemote(child) end
end

local function preventKickOnce()
    if not (getrawmetatable and setreadonly and newcclosure and getnamecallmethod) then return end
    local executor = ""
    if identifyexecutor then
        local ok, name = pcall(identifyexecutor)
        if ok and type(name) == "string" then executor = name:lower() end
    end
    if executor:find("solara", 1, true) or executor:find("xeno", 1, true) then return end
    local ok, err = pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        local wrapped = newcclosure(function(self, ...)
            if self == player and getnamecallmethod() == "Kick" then return end
            return old(self, ...)
        end)
        local wasReadonly = true
        if isreadonly then wasReadonly = isreadonly(mt) end
        setreadonly(mt, false)
        local installed, installError = pcall(function() mt.__namecall = wrapped end)
        setreadonly(mt, wasReadonly)
        if not installed then error(installError) end
    end)
end

