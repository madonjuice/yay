local function ThemeColors(theme)
    local bg = theme.Background or Color3.fromRGB(0,0,0)
    local text = theme.Text or Color3.new(1,1,1)
    return {
        bg=bg, card=theme.ElementColor or bg:Lerp(text,0.08), text=text,
        muted=theme.Muted or text:Lerp(bg,0.4), accent=theme.Accent or text,
        line=theme.Outline or text:Lerp(bg,0.75), placeholder=theme.Placeholder or bg,
    }
end
local function RecolorTree(root, old, new)
    if not root then return end
    local objects = {root}
    for _, object in ipairs(root:GetDescendants()) do table.insert(objects, object) end
    local properties = {"BackgroundColor3", "TextColor3", "PlaceholderColor3", "ScrollBarImageColor3"}
    for _, object in ipairs(objects) do
        for _, property in ipairs(properties) do
            local ok, value = pcall(function() return object[property] end)
            if ok then
                if value == old.bg then pcall(function() object[property] = new.bg end)
                elseif value == old.card then pcall(function() object[property] = new.card end)
                elseif value == old.text then pcall(function() object[property] = new.text end)
                elseif value == old.muted then pcall(function() object[property] = new.muted end)
                elseif value == old.accent then pcall(function() object[property] = new.accent end)
                elseif value == old.line then pcall(function() object[property] = new.line end)
                elseif value == old.placeholder then pcall(function() object[property] = new.placeholder end) end
            end
        end
        if object:IsA("UIStroke") and object.Color == old.line then object.Color = new.line end
    end
end

