local function SafeGroup(tab, cfg)
    local state = GroupLayouts[tab]
    if not state then
        state = {count=0,leftEstimate=0,rightEstimate=0}
        GroupLayouts[tab] = state
    end
    state.count += 1
    local cardIndex = state.count
    local card, content, cardEstimateKey

    local function ensureCard(entry)
        if card then return end
        local rightScroll = entry and entry.RightScroll
        if not rightScroll then return end
        if not state.grid then
            state.mobile = UserInputService.TouchEnabled
            state.grid = Instance.new("Frame")
            state.grid.Name = "FeatureCardGrid"
            state.grid.BackgroundTransparency = 1
            state.grid.Size = UDim2.new(1,-12,0,0)
            state.grid.ZIndex = 15
            state.grid.Parent = rightScroll
            state.left = Instance.new("Frame")
            state.left.Name = "FeatureCardColumnLeft"
            state.left.BackgroundTransparency = 1
            state.left.Position = UDim2.new(0,0,0,0)
            state.left.Size = state.mobile and UDim2.new(1,0,0,0) or UDim2.new(0.5,-6,0,0)
            state.left.Parent = state.grid
            state.right = Instance.new("Frame")
            state.right.Name = "FeatureCardColumnRight"
            state.right.BackgroundTransparency = 1
            state.right.Position = UDim2.new(0.5,6,0,0)
            state.right.Size = UDim2.new(0.5,-6,0,0)
            state.right.Visible = not state.mobile
            state.right.Parent = state.grid
            state.leftLayout = Instance.new("UIListLayout")
            state.leftLayout.Padding = UDim.new(0,8)
            state.leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
            state.leftLayout.Parent = state.left
            state.rightLayout = Instance.new("UIListLayout")
            state.rightLayout.Padding = UDim.new(0,8)
            state.rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
            state.rightLayout.Parent = state.right
            local function fitGrid()
                state.grid.Size = UDim2.new(1,-12,0,math.max(state.leftLayout.AbsoluteContentSize.Y,state.rightLayout.AbsoluteContentSize.Y))
            end
            state.leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitGrid)
            state.rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitGrid)
        end
        local column
        if state.mobile then
            column = state.left
        elseif cfg.FullWidth then
            column = rightScroll
        elseif cfg.Column == "Left" then
            column = state.left
        elseif cfg.Column == "Right" then
            column = state.right
        else
            column = state.leftEstimate <= state.rightEstimate and state.left or state.right
        end
        if not column or not column.Parent then return end
        local fullWidth = cfg.FullWidth == true and not state.mobile
        if not fullWidth then
            cardEstimateKey = column == state.left and "leftEstimate" or "rightEstimate"
            state[cardEstimateKey] += 50
        end

        card = Instance.new("Frame")
        card.Name = (cfg.Title or "Feature") .. "Card"
        card.LayoutOrder = cardIndex
        card.Size = fullWidth and UDim2.new(1,-12,0,0) or UDim2.new(1,0,0,0)
        card.BackgroundColor3 = Color3.fromRGB(20,20,20)
        card.BorderSizePixel = 0
        card.ZIndex = 15
        card.Parent = column

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0,10)
        corner.Parent = card
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(48,48,48)
        stroke.Transparency = 0.25
        stroke.Thickness = 1
        stroke.Parent = card
        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0,10)
        padding.PaddingBottom = UDim.new(0,10)
        padding.PaddingLeft = UDim.new(0,10)
        padding.PaddingRight = UDim.new(0,10)
        padding.Parent = card
        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0,8)
        layout.Parent = card
        local function fitCard()
            card.Size = UDim2.new(1, fullWidth and -12 or 0, 0, layout.AbsoluteContentSize.Y + 20)
        end
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitCard)

        local iconName = cfg.Icon or GroupIcons[cfg.Title]
        local header = Instance.new("Frame")
        header.Name = "FeatureCardHeader"
        header.BackgroundTransparency = 1
        header.Size = UDim2.new(1,0,0,22)
        header.ZIndex = 16
        header.Parent = card
        local headerTitle = Instance.new("TextLabel")
        headerTitle.Name = "FeatureCardTitle"
        headerTitle.BackgroundTransparency = 1
        headerTitle.Position = UDim2.new(0,iconName and 25 or 0,0,0)
        headerTitle.Size = UDim2.new(1,iconName and -25 or 0,1,0)
        headerTitle.Font = Enum.Font.GothamSemibold
