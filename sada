-- Show a short one-time walkthrough; Start and Skip both save the user's choice.
do
    local tutorialFlag = "AERO_TPS_Tutorial_0.0.0.4.txt"
    local tutorialSeen = false
    if type(isfile) == "function" then
        local ok, exists = pcall(isfile, tutorialFlag)
        tutorialSeen = ok and exists == true
    end
    if not tutorialSeen and type(readfile) == "function" then
        local ok, saved = pcall(readfile, tutorialFlag)
        tutorialSeen = ok and type(saved) == "string" and saved == "seen"
    end

    if (not tutorialSeen or Window.SetupWasNew) and Window.TutorialChoice ~= false then
        task.defer(function()
            if not Window or type(Window.AddPanel) ~= "function" then return end
            local host = Window:AddPanel({Name="FirstRunTutorial", HeaderButton=false})
            if not host or type(host.CreateModal) ~= "function" then return end
            local overlay, card = host:CreateModal(340, 286)
            if not overlay or not card then return end
            overlay.BackgroundTransparency = 1
            overlay.Text = ""
            overlay.Active = true
            card.AnchorPoint = Vector2.new(0,0.5)
            card.Position = UDim2.new(0,18,0.5,0)
            card.ZIndex = 1810
            card.BackgroundColor3 = Color3.fromRGB(13,15,19)
            card.BorderSizePixel = 0
            card.Active = true
            Instance.new("UICorner", card).CornerRadius = UDim.new(0,12)
            local outline = Instance.new("UIStroke")
            outline.Color = Color3.fromRGB(66,72,82)
            outline.Transparency = 0.25
            outline.Parent = card

            local tutorialBlur = Instance.new("BlurEffect")
            tutorialBlur.Name = "AERO_TutorialBlur"
            tutorialBlur.Size = 12
            tutorialBlur.Parent = Lighting
            local spotlightParts = {}
            local function clearSpotlight()
                for _, part in ipairs(spotlightParts) do
                    if part and part.Parent then part:Destroy() end
                end
                table.clear(spotlightParts)
            end
            local function addMask(position, size)
                if (size.X.Scale <= 0 and size.X.Offset <= 0)
                    or (size.Y.Scale <= 0 and size.Y.Offset <= 0) then return end
                local mask = Instance.new("Frame")
                mask.Name = "TutorialDimmer"
                mask.Position = position
                mask.Size = size
                mask.BackgroundColor3 = Color3.fromRGB(3,5,8)
                mask.BackgroundTransparency = 0.42
                mask.BorderSizePixel = 0
                mask.Active = false
                mask.ZIndex = 1801
                mask.Parent = overlay
                table.insert(spotlightParts, mask)
            end
            local function refreshSpotlight(target, clip)
                clearSpotlight()
                local bounds = overlay.AbsoluteSize
                local x, y, width, height = 0, 0, 0, 0
                local hasTarget = target and target.Parent and target.Visible
                    and target.AbsoluteSize.X > 0 and target.AbsoluteSize.Y > 0
                if hasTarget then
                    local margin = 9
                    local left, top = target.AbsolutePosition.X, target.AbsolutePosition.Y
                    local right = left + target.AbsoluteSize.X
                    local bottom = top + target.AbsoluteSize.Y
                    if clip and clip.Parent and clip.AbsoluteSize.X > 0 and clip.AbsoluteSize.Y > 0 then
                        local clipLeft, clipTop = clip.AbsolutePosition.X, clip.AbsolutePosition.Y
                        local clipRight = clipLeft + clip.AbsoluteSize.X
                        local clipBottom = clipTop + clip.AbsoluteSize.Y
                        left, top = math.max(left, clipLeft), math.max(top, clipTop)
                        right, bottom = math.min(right, clipRight), math.min(bottom, clipBottom)
                        left, top = math.max(clipLeft, left - margin), math.max(clipTop, top - margin)
                        right, bottom = math.min(clipRight, right + margin), math.min(clipBottom, bottom + margin)
                    else
                        left, top = left - margin, top - margin
                        right, bottom = right + margin, bottom + margin
                    end
                    left = math.clamp(left - overlay.AbsolutePosition.X, 0, bounds.X)
                    top = math.clamp(top - overlay.AbsolutePosition.Y, 0, bounds.Y)
                    right = math.clamp(right - overlay.AbsolutePosition.X, left, bounds.X)
                    bottom = math.clamp(bottom - overlay.AbsolutePosition.Y, top, bounds.Y)
                    x, y = left, top
                    width, height = right - left, bottom - top
                    hasTarget = width > 0 and height > 0
                end
                addMask(UDim2.fromOffset(0,0), UDim2.new(1,0,0,y))
                addMask(UDim2.fromOffset(0,y+height), UDim2.new(1,0,0,math.max(0,bounds.Y-y-height)))
                addMask(UDim2.fromOffset(0,y), UDim2.fromOffset(x,height))
                addMask(UDim2.fromOffset(x+width,y), UDim2.fromOffset(math.max(0,bounds.X-x-width),height))
                if target and target.Parent and target.AbsoluteSize.X > 0 and target.AbsoluteSize.Y > 0 then
                    local border = Instance.new("Frame")
                    border.Name = "TutorialSpotlight"
                    border.Position = UDim2.fromOffset(x,y)
                    border.Size = UDim2.fromOffset(width,height)
                    border.BackgroundTransparency = 1
                    border.BorderSizePixel = 0
                    border.ZIndex = 1802
                    border.Parent = overlay
                    local stroke = Instance.new("UIStroke")
                    stroke.Color = Color3.fromRGB(115,190,255)
                    stroke.Thickness = 2
                    stroke.Transparency = 0.05
                    stroke.Parent = border
                    Instance.new("UICorner", border).CornerRadius = UDim.new(0,9)
                    table.insert(spotlightParts, border)
                end
            end
            local function findStepTarget(step)
