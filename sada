local function cleanupBallCrasherCharacter()
    if ballCrasherForce then ballCrasherForce:Destroy(); ballCrasherForce=nil end
    if ballCrasherHighlight then ballCrasherHighlight:Destroy(); ballCrasherHighlight=nil end
    if ballCrasherRoot and ballCrasherRoot.Parent and ballCrasherOriginalTransparency ~= nil then
        ballCrasherRoot.Transparency = ballCrasherOriginalTransparency
    end
    local camera = workspace.CurrentCamera
    if camera and ballCrasherOriginalCamera and ballCrasherOriginalCamera.Parent then
        camera.CameraSubject = ballCrasherOriginalCamera
    elseif camera and ballCrasherHumanoid and ballCrasherHumanoid.Parent then
        camera.CameraSubject = ballCrasherHumanoid
    end
    ballCrasherCharacter, ballCrasherRoot, ballCrasherHumanoid = nil,nil,nil
    ballCrasherOriginalTransparency, ballCrasherOriginalCamera = nil,nil
    ballCrasherDeathTriggered = false
end

local function stopBallCrasher()
    ballCrasherEnabled = false
    if ballCrasherConnection then ballCrasherConnection:Disconnect(); ballCrasherConnection=nil end
    cleanupBallCrasherCharacter()
end

local function startBallCrasher()
    if ballCrasherConnection then return end
    ballCrasherEnabled = true
    ballCrasherConnection = RunService.Heartbeat:Connect(function()
        if not ballCrasherEnabled then return end
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local system = workspace:FindFirstChild("TPSSystem")
        local ball = system and system:FindFirstChild("TPS")
        if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart")
            or not ball or not ball:IsA("BasePart") then return end

        if character ~= ballCrasherCharacter or root ~= ballCrasherRoot then
            cleanupBallCrasherCharacter()
            ballCrasherEnabled = true
            ballCrasherCharacter, ballCrasherRoot, ballCrasherHumanoid = character,root,humanoid
            ballCrasherOriginalTransparency = root.Transparency
            local camera = workspace.CurrentCamera
            ballCrasherOriginalCamera = camera and camera.CameraSubject
            ballCrasherDeathTriggered = false
        end

        root.CFrame = ball.CFrame + ballCrasherOffset
        root.Rotation = Vector3.new(0,90,0)
        if not ballCrasherForce or ballCrasherForce.Parent ~= root then
            if ballCrasherForce then ballCrasherForce:Destroy() end
            ballCrasherForce = Instance.new("BodyVelocity")
            ballCrasherForce.Name = "AERO_BallCrasherVelocity"
            ballCrasherForce.Parent = root
        end
        ballCrasherForce.Velocity = ballCrasherVelocity
        ballCrasherForce.MaxForce = Vector3.new(math.huge,math.huge,math.huge)

        if not ballCrasherHighlight then
            ballCrasherHighlight = Instance.new("Highlight")
            ballCrasherHighlight.Name = "AERO_BallCrasherHighlight"
            ballCrasherHighlight.Adornee = root
            ballCrasherHighlight.FillColor = Color3.fromRGB(125,125,255)
            ballCrasherHighlight.FillTransparency = 0.5
            ballCrasherHighlight.OutlineTransparency = 1
            ballCrasherHighlight.Parent = character
        end
        root.Transparency = 0.99
        local camera = workspace.CurrentCamera
        if camera then camera.CameraSubject = ball end

        if not ballCrasherDeathTriggered then
            ballCrasherDeathTriggered = true
            task.delay(2.5,function()
                if ballCrasherEnabled and player.Character == character and humanoid.Parent then
                    humanoid:ChangeState(Enum.HumanoidStateType.Dead)
                end
            end)
        end
    end)
end

