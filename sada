local function isRandomCleanupName(name)
    -- Session IDs vary: match mixed letters/digits, not just hexadecimal IDs.
    return #name >= 8
        and name:match("^[A-Za-z0-9]+$") ~= nil
        and name:match("[A-Za-z]") ~= nil
        and name:match("[0-9]") ~= nil
end

-- Matches leaderboard-hidden names such as "w404k-774b", "o-947j96q",
-- and the three-part form "m-90g-272f".
local function isLeaderboardScriptName(name)
    return name:match("^[A-Za-z0-9]+%-[A-Za-z0-9]+%-[A-Za-z0-9]+$") ~= nil
        or name:match("^[A-Za-z0-9]+%-[A-Za-z0-9]+$") ~= nil
end

local function isScriptInstance(instance)
    return instance:IsA("LocalScript") or instance:IsA("Script") or instance:IsA("ModuleScript")
end

local function cleanNamedScripts(root)
    if stopped or not root or not root.Parent then return end
    for _, desc in ipairs(root:GetDescendants()) do
        if not stopped and isScriptInstance(desc) then
            if isLeaderboardScriptName(desc.Name) or isRandomCleanupName(desc.Name) then
                safeDestroy(desc)
            end
        end
    end
end

