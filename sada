end

local function safeDestroy(instance)
    if not instance or destroyed[instance] then return false end
    local path = instance:GetFullName()
    local className = instance.ClassName
    local ok, err = pcall(function() instance:Destroy() end)
    if ok then
        destroyed[instance] = true
        destroyedCount = destroyedCount + 1
    else
        failureCount = failureCount + 1
    end
    return ok
end

local skipped = setmetatable({}, { __mode = "k" })
local function cleanScript(root, ...)
    local instance = findPath(root, ...)
    if not instance then return end
    if instance:IsA("LocalScript") or instance:IsA("Script") then
        safeDestroy(instance)
    elseif not skipped[instance] then
        skipped[instance] = true
    end
end

