    local anyActive=airDribbleEnabled or legShow or armShow or headShow
        or headVisSolara or leftLegVisSolara or rightLegVisSolara or leftArmVisSolara or rightArmVisSolara
        or ballShow or legOn or armOn or headOn or ballOn or antiBallFlingEnabled
    if not anyActive then return end

    if airDribbleEnabled then
        local isAirborne = not airDribbleOnlyOnJump or IsPlayerAirborne()
        local tpsSystem=workspace:FindFirstChild("TPSSystem") local activeBalls={}
        if tpsSystem and isAirborne then
            local tpsBall = tpsSystem:FindFirstChild("TPS")
