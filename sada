-- Shared head reach, independent of the Moss/react presets below.
do
    local enabled, show = false, false
    local dimensions = Vector3.new(3.5,3.5,3.5)
    local useResize = isSolara or isXeno or type(firetouchinterest) ~= "function"
    local loop, visual, realHead, fakeHead, original
    local lastTouches = setmetatable({}, {__mode = "k"})
    local function restore()
        if fakeHead then fakeHead:Destroy(); fakeHead = nil end
        if realHead and realHead.Parent and original then
            realHead.Size = original.Size
            realHead.Transparency = original.Transparency
            realHead.CanCollide = original.CanCollide
            realHead.Massless = original.Massless
            for decal, transparency in pairs(original.Decals) do
                if decal.Parent then decal.Transparency = transparency end
            end
        end
        realHead, original = nil, nil
        table.clear(lastTouches)
    end
    local function resizeHead(head)
        if realHead ~= head then
            restore()
            local clone = head:Clone()
            if not clone then return end
            for _, item in ipairs(clone:GetDescendants()) do
                if item:IsA("JointInstance") or item:IsA("WeldConstraint") or item:IsA("Script")
                    or item:IsA("LocalScript") or item:IsA("TouchTransmitter") then item:Destroy() end
            end
            original = {Size = head.Size, Transparency = head.Transparency,
                CanCollide = head.CanCollide, Massless = head.Massless, Decals = {}}
            realHead = head
            clone.Name = "AERO_FakeHead"
            clone.Anchored = false; clone.Massless = true
            clone.CanCollide, clone.CanTouch, clone.CanQuery = false, false, false
            clone.CFrame = head.CFrame
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = head; weld.Part1 = clone; weld.Parent = clone
            clone.Parent = head.Parent
            fakeHead = clone
            for _, item in ipairs(head:GetDescendants()) do
                if item:IsA("Decal") or item:IsA("Texture") then
                    original.Decals[item] = item.Transparency
                    item.Transparency = 1
                end
            end
        end
        if head.Size ~= dimensions then head.Size = dimensions end
        head.Transparency = 1; head.CanCollide = false; head.Massless = true
    end
    local function step()
        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not head or not head:IsA("BasePart") or not hum or hum.Health <= 0 then
            restore()
            if visual then visual:Destroy(); visual = nil end
            return
        end
        if enabled and useResize then resizeHead(head)
        elseif realHead then restore() end
        if show then
            if not visual then visual = makeVis(Color3.fromRGB(255,80,80),Enum.PartType.Block) end
            visual.CFrame = head.CFrame
            visual.Size = dimensions
        elseif visual then visual:Destroy(); visual = nil end
        if enabled and not useResize then
            local half, now = dimensions / 2, os.clock()
            for _, ball in ipairs(ballList) do
                if ball and ball.Parent then
                    local delta = head.CFrame:PointToObjectSpace(ball.Position)
                    if math.abs(delta.X) <= half.X and math.abs(delta.Y) <= half.Y and math.abs(delta.Z) <= half.Z
                        and now - (lastTouches[ball] or -math.huge) >= 0.03 then
                        lastTouches[ball] = now
                        pcall(function() firetouchinterest(ball,head,0); firetouchinterest(ball,head,1) end)
                    end
                end
            end
        end
    end
    local function refresh()
        if loop then loop:Disconnect(); loop = nil end
        if not enabled then restore() end
        if not show and visual then visual:Destroy(); visual = nil end
        if enabled or show then step(); loop = RunService.Heartbeat:Connect(step) end
    end
    local HeadReachGroup = SafeGroup(HeadReachTab, {Title="Head Reach", Collapsed=false})
    HeadReachGroup:Toggle({Title = "Head Reach Enabled", Default = false, Callback = function(value)
        enabled = value; setFeatureState("Head Reach Enabled",value); refresh()
    end})
    for index, axis in ipairs({"X","Y","Z"}) do
        HeadReachGroup:Slider({Title = "Head Reach " .. axis, Value = {Min = 0.5, Max = 7, Default = 3.5}, Step = 0.5,
            Callback = function(value)
                if index == 1 then dimensions = Vector3.new(value,dimensions.Y,dimensions.Z)
                elseif index == 2 then dimensions = Vector3.new(dimensions.X,value,dimensions.Z)
                else dimensions = Vector3.new(dimensions.X,dimensions.Y,value) end
                setSliderState("Head Reach " .. axis,value)
                if enabled or show then step() end
            end})
    end
    HeadReachGroup:Toggle({Title = "Head Visualizer", Default = false, Callback = function(value) show = value; refresh() end})
    player.CharacterRemoving:Connect(function()
        restore()
        if visual then visual:Destroy(); visual = nil end
    end)
end
