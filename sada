                ["Arm Visualizers"] = "Show or hide the arm reach visualizers.",
                ["Left Arm Reach"] = "Toggle and set the size of left arm reach.",
                ["Right Arm Reach"] = "Toggle and set the size of right arm reach.",
                ["Head Reach"] = "Toggle head reach and adjust its range and visualizer.",
