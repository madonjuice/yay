local function spoofPingDisplay(targetPing)
    local CoreGui = game:GetService("CoreGui")
    local ok, perfStats = pcall(function()
        return CoreGui:FindFirstChild("RobloxGui"):WaitForChild("PerformanceStats", 5)
    end)
    if not ok or not perfStats then return false end

    for _, child in ipairs(perfStats:GetChildren()) do
        local titleLabel = child:FindFirstChild("TitleLabel", true)
        if titleLabel and titleLabel.Text:lower():gsub(" ", ""):find("networkping") then
            local valueLabel = child:FindFirstChild("ValueLabel", true)
            local psBarFrame = child:FindFirstChild("PS_BarFrame", true)

            if psBarFrame then psBarFrame.Visible = false end

            local finalGraph = child:FindFirstChild("FinalStableGraph", true)
            if finalGraph then finalGraph:Destroy() end

            local newGraph = Instance.new("Frame")
            newGraph.Name = "FinalStableGraph"
            newGraph.Parent = psBarFrame and psBarFrame.Parent or child
            newGraph.Size = psBarFrame and psBarFrame.Size or UDim2.new(1, 0, 0, 50)
            newGraph.Position = psBarFrame and psBarFrame.Position or UDim2.new(0, 0, 1, -50)
            newGraph.BackgroundTransparency = 1
            newGraph.ClipsDescendants = true

            local layout = Instance.new("UIListLayout")
            layout.Parent = newGraph
            layout.FillDirection = Enum.FillDirection.Horizontal
            layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
            layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
            layout.Padding = UDim.new(0, 0)

            local bars = createGraphBars(newGraph)

            local pingText = tostring(math.floor(targetPing)) .. " ms"
            if valueLabel then valueLabel.Text = pingText end

            for _, descendant in ipairs(child:GetDescendants()) do
                if descendant:IsA("TextLabel") and descendant.Text:find("Current:") then
                    descendant.Text = "Current: " .. pingText
                end
            end

            for _, bar in ipairs(bars) do
                local height = math.clamp(targetPing / 100, 0.05, 1)
                bar.Size = UDim2.new(0.02, 0, height, 0)
                bar.BackgroundColor3 = Color3.fromRGB(126, 211, 33)
            end

             
            pcall(function() game:GetService("RunService"):UnbindFromRenderStep("PingSpoofLock") end)

            game:GetService("RunService"):BindToRenderStep("PingSpoofLock", Enum.RenderPriority.Last.Value, function()
                pcall(function()
                    if valueLabel then valueLabel.Text = tostring(math.floor(targetPing)) .. " ms" end
                end)
            end)

            return true
        end
    end
    return false
end

