    local function Fetch()
        if fetching or not alive or not token or cursor == nil then return end
        fetching = true
        local completed, problem = pcall(function()
        local ok, data = Call("GET","/messages?after=" .. tostring(cursor),nil,token)
        if alive then
            if ok and type(data.messages) == "table" then
                local bottom = #rows == 0 or list.CanvasPosition.Y + list.AbsoluteWindowSize.Y >= list.AbsoluteCanvasSize.Y - 40
                local incoming, newest = 0, nil
                for _, message in ipairs(data.messages) do
                    if type(message) == "table" and type(message.id) == "number" then
                        if message.id > cursor and not seen[message.id] and type(message.text) == "string" and type(message.name) == "string" and tonumber(message.userId) ~= localPlayer.UserId then incoming += 1; newest = message end
                        Append(message); cursor = math.max(cursor,message.id)
                    end
                end
                Online(data)
                local viewing = host:IsVisible() and chat.Visible and not modal.Visible
                if viewing then MarkRead()
                elseif incoming > 0 then
                    unread += incoming; unreadBadge.Text = unread > 99 and "99+" or tostring(unread); unreadBadge.Visible = true
                end
                if incoming > 0 and (not preferences.OnlyWhenHidden or not viewing) then
                    if preferences.Notifications then
                        local preview = "Open Community to read " .. (incoming == 1 and "the new message." or tostring(incoming) .. " new messages.")
                        if preferences.Preview and newest then
                            local cut = utf8.offset(newest.text,101)
                            preview = newest.name .. ": " .. (cut and newest.text:sub(1,cut-1) .. "…" or newest.text)
                        end
                        ShowAlert(incoming == 1 and "New chat message" or tostring(incoming) .. " new chat messages", preview)
                    end
                    if preferences.Sounds then PlayChatSound() end
                end
                if bottom and preferences.AutoScroll then task.defer(function() if alive then list.CanvasPosition = Vector2.new(0,math.max(0,list.AbsoluteCanvasSize.Y-list.AbsoluteWindowSize.Y)) end end) end
            else Fail(data) end
        end
        end)
        fetching = false
        if not completed and alive then
            status.Text = "Chat refresh failed; retrying shortly."
            warn("[AERO Chat refresh] " .. tostring(problem))
        end
    end
    local function Send()
        if sending or not alive or not token or cursor == nil or blocked then return end
        local text = input.Text:match("^%s*(.-)%s*$")
