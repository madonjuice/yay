do
    local originalTab = Window.Tab
    function Window:Tab(options)
        local tab = originalTab(self, options)
        local tabKey = (options.Title or "Tab"):gsub("^│%s*", "")
        local tabIndex = #Window.TabList
        local tabFrame = Window.Tabs[#Window.Tabs]
        local function updateActiveMarker()
            for i, frame in ipairs(Window.Tabs) do
                local label = frame:FindFirstChildWhichIsA("TextLabel", true)
                local item = Window.TabList[i]
                if label and item then
                    label.Text = (i == tabIndex and "│ " or "") .. item.Title
                end
            end
        end
        local selectTab = tab.Select
        tab.Select = function(...)
            updateActiveMarker()
            if selectTab then return selectTab(...) end
        end
        local tabButton = tabFrame and tabFrame:FindFirstChildWhichIsA("TextButton")
        if tabButton then tabButton.Activated:Connect(updateActiveMarker) end
        if tabKey == "Settings" then return tab end
        for _, kind in ipairs({"Toggle", "Slider", "Dropdown", "Input", "Keybind"}) do
            local create = tab[kind]
            tab[kind] = function(self, cfg)
                local key = tabKey .. "/" .. kind .. "/" .. cfg.Title
                local initial = cfg.Value
                if kind == "Toggle" then initial = cfg.Default == true
                elseif kind == "Slider" then initial = cfg.Value.Default
                elseif initial == nil then initial = "" end
                local entry = {Kind = kind, Config = cfg, Value = initial, Default = initial}
                ConfigStore.Entries[key] = entry
                table.insert(ConfigStore.Order, key)
                local callback = cfg.Callback
                cfg.Callback = function(value)
                    entry.Value = value
                    if callback then
                        local ok, err = pcall(callback, value)
                        if not ok then
                            ConfigStore.Errors[key] = tostring(err)
                        end
                    end
                end
                entry.Callback = cfg.Callback
                entry.Element = create(self, cfg)
                return entry.Element
            end
        end
        return tab
    end
end

